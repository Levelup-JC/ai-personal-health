# Copy to .env locally. Values stay off-repo.
# WHOOP MCP (Grok Bot connector / self-hosted HTTP MCP)
WHOOP_MCP_BASE_URL=<REDACTED>
WHOOP_MCP_BEARER=<REDACTED>

# Notion (fitness ledger) — use a dedicated integration; never share with family agent
NOTION_TOKEN=<REDACTED>
NOTION_DB_NUTRITION=<collection-or-db-id-placeholder>
NOTION_DB_TRAINING=<collection-or-db-id-placeholder>
NOTION_DB_BODY=<collection-or-db-id-placeholder>
NOTION_PAGE_DAILY_MEALS=<page-id-placeholder>
NOTION_PAGE_FITNESS_MEMORY=<page-id-placeholder>

# Alert channel (self-hosted ntfy). Push body must NOT include health numbers.
NTFY_BASE_URL=<REDACTED>
NTFY_TOPIC=<REDACTED>
NTFY_TOKEN=<REDACTED>

# Optional LLM gateway for offline workers (e.g. Magpie)
LLM_BASE_URL=http://127.0.0.1:3425/v1
LLM_API_KEY=<REDACTED>
LLM_MODEL=apikeyfan/claude-opus-5-5
